# See docker-compose.yml. Only /functions/v1/ is passed on; nothing is stored or logged here
# (register tokens travel in the Authorization header: Traefik's access log has paths only).
server {
    listen 8080;
    server_tokens off;
    access_log off;
    client_max_body_size 2m;

    # Docker's resolver, so the upstream's address is looked up again when it changes.
    resolver 127.0.0.11 valid=60s ipv6=off;
    set $portal_upstream https://${PORTAL_UPSTREAM_HOST};

    location /functions/v1/ {
        proxy_pass $portal_upstream;
        proxy_set_header Host ${PORTAL_UPSTREAM_HOST};
        proxy_ssl_server_name on;
        proxy_ssl_name ${PORTAL_UPSTREAM_HOST};
        proxy_ssl_verify on;
        proxy_ssl_verify_depth 3;
        proxy_ssl_trusted_certificate /etc/ssl/certs/ca-certificates.crt;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        # The caller's address as Traefik saw it: the portal limits link attempts per address.
        # The portal's host replaces X-Forwarded-For with the address that connects to it (this
        # server: measured 2026-11-17), so the caller's address also travels in a header of our
        # own. It is always set here, so a caller cannot send its own; the portal trusts it only
        # on requests that come from this server's address.
        proxy_set_header X-Forwarded-For $http_x_forwarded_for;
        proxy_set_header X-GarageAI-Client-IP $http_x_forwarded_for;
        proxy_connect_timeout 10s;
        proxy_send_timeout 60s;
        proxy_read_timeout 200s;   # register-node runs the acceptance test: up to 190 s
    }

    location / { return 404; }
}
