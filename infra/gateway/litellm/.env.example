# Copy to .env and fill in. Never commit .env.

# Public hostname for the LiteLLM API (DNS A record → this VPS)
LITELLM_DOMAIN=llm.garageai.eu
# The public API name in the docs; same paths and protection, no admin API (2026-10-12).
LITELLM_API_DOMAIN=api.garageai.eu

# Docker network created by the NetBird installer: "<install directory name>_netbird".
# Check with: docker network ls | grep netbird
NETBIRD_NETWORK=netbird_netbird

# Generate each with: echo "sk-$(openssl rand -hex 24)"
LITELLM_MASTER_KEY=sk-change-me
# Encrypts stored credentials. Cannot be changed later without losing them.
LITELLM_SALT_KEY=sk-change-me

# Generate with: openssl rand -hex 24
POSTGRES_PASSWORD=change-me

# Pinned LiteLLM release (ghcr.io/berriai/litellm tags)
LITELLM_VERSION=v1.104.2
