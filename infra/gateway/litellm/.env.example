# Copy to .env and fill in. Never commit .env.

# Public hostname for the LiteLLM API (DNS A record → this VPS)
LITELLM_DOMAIN=llm.garageai.eu
# The public API name in the docs; same paths and protection, no admin API (2026-10-12).
LITELLM_API_DOMAIN=api.garageai.eu

# Docker network shared with Traefik (created by infra/gateway/traefik/docker-compose.yml).
# Check with: docker network ls | grep garageai_proxy
PROXY_NETWORK=garageai_proxy

# Generate each with: echo "sk-$(openssl rand -hex 24)"
LITELLM_MASTER_KEY=sk-change-me
# The portal's key for the admin API (its LITELLM_MASTER_KEY secret holds THIS value, not the
# master key): Traefik lets it reach only the paths the portal uses and swaps in the master key.
LITELLM_PORTAL_KEY=sk-change-me-too
# Who may use the master key itself on the admin API. Empty = anyone who has it; set to this
# server's own address (e.g. 203.0.113.7/32) once the portal uses LITELLM_PORTAL_KEY.
LITELLM_ADMIN_SOURCE=
# Encrypts stored credentials. Cannot be changed later without losing them.
LITELLM_SALT_KEY=sk-change-me

# Generate with: openssl rand -hex 24
POSTGRES_PASSWORD=change-me

# Pinned LiteLLM release (ghcr.io/berriai/litellm tags)
LITELLM_VERSION=v1.104.2
