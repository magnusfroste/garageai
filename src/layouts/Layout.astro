---
import '../index.css';

interface Props {
  title: string;
  description: string;
  image?: string;
}

const { title, description, image = '/og-image.png' } = Astro.props;

const site = Astro.site ?? new URL('https://www.garageai.eu');
const canonicalURL = new URL(Astro.url.pathname, site).href;
const imageURL = new URL(image, site).href;

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Garage AI',
  alternateName: 'GarageAI',
  url: site.href,
  logo: new URL('/favicon.svg', site).href,
  image: imageURL,
  email: 'powerup@garageai.eu',
  slogan: "Your Garage. Europe's AI Engine.",
  description:
    "A marketplace for local AI inference in Europe: garage owners offer their GPUs and get paid per token, buyers use open models through one OpenAI-compatible API.",
  foundingDate: '2025',
  foundingLocation: { '@type': 'Place', name: 'Sweden' },
  address: { '@type': 'PostalAddress', addressCountry: 'SE' },
  knowsAbout: [
    'Sovereign AI',
    'Distributed AI inference',
    'Local large language models',
    'OpenAI-compatible API',
    'Decentralized computing',
    'European AI sovereignty',
  ],
  sameAs: ['https://github.com/magnusfroste/garageai'],
};

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Garage AI',
  url: site.href,
  description:
    "Local, sovereign AI inference from GPUs in European garages. Offer your GPU or use AI through an OpenAI-compatible API.",
  inLanguage: 'en',
  publisher: { '@type': 'Organization', name: 'Garage AI', url: site.href },
};
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="keywords" content="Garage AI, GarageAI, sovereign AI, local AI inference, GPU marketplace, OpenAI-compatible API, earn with your GPU, Europe AI, decentralized AI, Ollama, vLLM, LM Studio, llama.cpp" />
    <meta name="author" content="Garage AI" />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="language" content="English" />
    <meta name="generator" content={Astro.generator} />

    <!-- Open Graph / LinkedIn -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content="Garage AI — Local AI Inference from European Garages" />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={imageURL} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Garage AI — Your Garage. Europe's AI Engine." />
    <meta property="og:site_name" content="Garage AI" />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter / X -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content="Garage AI — Local AI Inference from European Garages" />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={imageURL} />
    <meta property="twitter:image:alt" content="Garage AI — Your Garage. Europe's AI Engine." />

    <!-- SEO -->
    <meta name="theme-color" content="#00D4FF" />
    <link rel="canonical" href={canonicalURL} />
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />

    <!-- Structured Data (JSON-LD) -->
    <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />

    <!-- Page-specific head (e.g. FAQPage structured data) -->
    <slot name="head" />
  </head>
  <body class="min-h-screen bg-[#080809]">
    <slot />
  </body>
</html>
