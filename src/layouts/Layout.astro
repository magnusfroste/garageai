---
interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="keywords" content="Garage AI, sovereign AI, distributed inference, Sweden AI, Europe AI, decentralized AI, V2G, solar AI, local AI, AI infrastructure" />
    <meta name="author" content="Garage AI" />
    <meta name="robots" content="index, follow" />
    <meta name="language" content="English" />

    <!-- Open Graph / LinkedIn -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://www.garageai.eu/" />
    <meta property="og:title" content="🇸🇪 Garage AI — Distributed Sovereign AI Infrastructure" />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="https://www.garageai.eu/og-image.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content="Garage AI" />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter / X -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content="https://www.garageai.eu/" />
    <meta property="twitter:title" content="🇸🇪 Garage AI — Distributed Sovereign AI Infrastructure" />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content="https://www.garageai.eu/og-image.png" />

    <!-- SEO -->
    <meta name="theme-color" content="#00D4FF" />
    <link rel="canonical" href="https://www.garageai.eu/" />

    <!-- Structured Data (JSON-LD) -->
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Organization",
      "name": "Garage AI",
      "url": "https://www.garageai.eu",
      "description": "Europe's first decentralized, sovereign AI infrastructure initiative — powered by solar panels, EV batteries, and 75 million garages.",
      "foundingDate": "2025",
      "address": { "@type": "PostalAddress", "addressCountry": "SE" },
      "sameAs": [
        "https://github.com/magnusfroste/garageai"
      ]
    }
    </script>
  </head>
  <body class="min-h-screen bg-[#080809]">
    <slot />
  </body>
</html>
