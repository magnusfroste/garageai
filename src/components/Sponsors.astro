---
import SponsorsReact from './SponsorsReact.jsx';

interface TechnicalPartner {
  name: string;
  location: string;
  tag: string;
  icon: string;
  color: string;
  description: string;
  url: string;
}

interface Partner {
  name: string;
  tagline: string;
  url: string;
  color: string;
}

interface Props {
  title: string;
  technicalPartner: TechnicalPartner;
  partners: Partner[];
}

const { title, technicalPartner, partners } = Astro.props;
---

<SponsorsReact 
  client:load
  title={title}
  technicalPartner={technicalPartner}
  partners={partners}
/>
