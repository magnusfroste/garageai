---
import SponsorsReact from './SponsorsReact.jsx';

interface TechnicalPartner {
  name: string;
  location: string;
  tag: string;
  icon: string;
  color: string;
  description: string;
  url: string;
}

interface Partner {
  name: string;
  tagline: string;
  url: string;
  color: string;
}

interface Minister {
  intro: string;
  name: string;
  rest: string;
  note: string;
}

interface Props {
  title: string;
  technicalPartner: TechnicalPartner;
  partners: Partner[];
  minister: Minister;
}

const { title, technicalPartner, partners, minister } = Astro.props;
---

<SponsorsReact
  client:load
  title={title}
  technicalPartner={technicalPartner}
  partners={partners}
  minister={minister}
/>
