---
import B2BReact from './B2BReact.jsx';

interface UseCase {
  icon: string;
  sector: string;
  example: string;
}

interface VpsMapping {
  from: string;
  to: string;
}

interface BenefitColumn {
  icon: string;
  title: string;
  color: string;
  bg: string;
  border: string;
  points: string[];
}

interface Props {
  title: string;
  subtitle: string;
  description: string;
  useCases: UseCase[];
  vpsMapping: VpsMapping[];
  benefitColumns: BenefitColumn[];
  quote: {
    text: string;
    author: string;
  };
  benefits: string[];
  ctaText: string;
  ctaButtonText: string;
  ctaUrl: string;
}

const { title, subtitle, description, useCases, vpsMapping, benefitColumns, quote, benefits, ctaText, ctaButtonText, ctaUrl } = Astro.props;
---

<B2BReact
  client:load
  title={title}
  subtitle={subtitle}
  description={description}
  useCases={useCases}
  vpsMapping={vpsMapping}
  benefitColumns={benefitColumns}
  quote={quote}
  benefits={benefits}
  ctaText={ctaText}
  ctaButtonText={ctaButtonText}
  ctaUrl={ctaUrl}
/>
